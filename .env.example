# Copia este archivo a .env y cambia ambas claves antes de usarlo.
DB_USERNAME=verpelis
DB_PASSWORD=cambia_esta_clave_local
MYSQL_ROOT_PASSWORD=cambia_esta_clave_root
MYSQL_PORT=3306
DB_URL=jdbc:mysql://localhost:3306/ver_pelis_plus
SPRING_PROFILES_ACTIVE=dev
AI_ENABLED=false
# Para activar IA: AI_ENABLED=true y una clave propia.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
